{
  "description": "Neral pre-commit gate (git commit needs a valid review stamp) and auto-allow for Edit and Write inside linked worktrees",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/precommit_gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree_allow.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
